# Copy to .env.local and fill private values; see DEV.md.
# MCP explicitly loads .env.local through Node --env-file.
# Django requires .env.local; process values override matching file values.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_NAME=campus_equipment
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# True selects local DB_*; False requires DATABASE_URL. Restart Django after switching.
IS_LOCAL_DB_CONNECTION=True
# Keep the private pooled Neon URL with TLS; local mode ignores it.
DATABASE_URL=
# Direct URL is for coordinator backup/import tools, not the Django connection.
DATABASE_URL_UNPOOLED=
MEDIA_STORAGE=local
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_STORAGE_BUCKET_NAME=assets
MCP_DATABASE_URL=
SEED_ACCOUNT_PASSWORD=

# MCP_DATABASE_URL is required by the shared MCP configuration.
# Use postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# sslmode=disable is for local loopback PostgreSQL only.
# DATABASE_URL/DB_* and DJANGO_* configure Django, not the MCP source.
# MCP may use a separate database account; update its URL independently.
# DB_PASSWORD is the raw password; URL credentials require percent encoding.
# DJANGO_DEBUG accepts exactly True or False; DB_PORT is an integer 1-65535.
# Host/origin values are comma-separated nonempty entries; trim whitespace.
# Django requires DJANGO_*, IS_LOCAL_DB_CONNECTION and the selected database keys.
# IS_LOCAL_DB_CONNECTION accepts exactly True or False; local is the template default.
# DATABASE_URL requires sslmode=require (or verify-ca/verify-full).
# MEDIA_STORAGE=neon requires all AWS_* keys above; local uses ignored media/.
# SEED_ACCOUNT_PASSWORD is required by seed_auth_accounts and seed_demo_data only.
# Generate DJANGO_SECRET_KEY with secrets.token_urlsafe(64); see DEV.md.
# Secret keys must have at least 50 characters and 5 distinct characters.
# Django reads values literally without ${...} interpolation.
# Quote private values containing # or whitespace in .env.local.
# Never put live values, demonstration passwords, or API tokens in this file.
# Time zone is fixed to Asia/Manila in the design, not an environment setting.
# Loan limits are database settings, not environment variables.
